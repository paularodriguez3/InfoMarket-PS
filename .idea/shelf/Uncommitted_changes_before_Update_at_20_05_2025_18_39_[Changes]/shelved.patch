<+><article id=\"product-details\">\r\n  <section id=\"product-details-info\">\r\n\r\n    <label for=\"product-name\">{{ 'PRODUCT.NAME_LABEL' | translate }}</label>\r\n    <div id=\"product-name\" class=\"product-name-wrapper\">\r\n      <label for=\"product-name-es\">{{ 'PRODUCT.NAME_LABEL' | translate }}\uD83C\uDDEA\uD83C\uDDF8</label>\r\n      <input type=\"text\" id=\"product-name-es\" name=\"product-name\" [(ngModel)]=\"selectedProductNameEs\" [placeholder]=\"'PRODUCT.NAME_PLACEHOLDER' | translate\" />\r\n\r\n      <label for=\"product-name-en\">{{ 'PRODUCT.NAME_LABEL' | translate }}\uD83C\uDDEC\uD83C\uDDE7</label>\r\n      <input type=\"text\" id=\"product-name-en\" name=\"product-name\" [(ngModel)]=\"selectedProductNameEn\" [placeholder]=\"'PRODUCT.NAME_PLACEHOLDER' | translate\" />\r\n\r\n      <label for=\"product-name-fr\">{{ 'PRODUCT.NAME_LABEL' | translate }}\uD83C\uDDEB\uD83C\uDDF7</label>\r\n      <input type=\"text\" id=\"product-name-fr\" name=\"product-name\" [(ngModel)]=\"selectedProductNameFr\" [placeholder]=\"'PRODUCT.NAME_PLACEHOLDER' | translate\" />\r\n\r\n      <label for=\"product-name-zh\">{{ 'PRODUCT.NAME_LABEL' | translate }}\uD83C\uDDE8\uD83C\uDDF3</label>\r\n      <input type=\"text\" id=\"product-name-zh\" name=\"product-name\" [(ngModel)]=\"selectedProductNameZh\" [placeholder]=\"'PRODUCT.NAME_PLACEHOLDER' | translate\" />\r\n    </div>\r\n\r\n    <hr class=\"hr-features\">\r\n\r\n    <label for=\"product-desc\">{{ 'PRODUCT.DESC_LABEL' | translate }}</label>\r\n    <div id=\"product-desc\" class=\"product-desc-wrapper\">\r\n      <label for=\"product-desc\">{{ 'PRODUCT.DESC_LABEL' | translate }}\uD83C\uDDEA\uD83C\uDDF8</label>\r\n      <input type=\"text\" id=\"product-desc-es\" name=\"product-desc\" [(ngModel)]=\"selectedDescriptionEs\" [placeholder]=\"'PRODUCT.DESC_PLACEHOLDER' | translate\" />\r\n      <label for=\"product-desc\">{{ 'PRODUCT.DESC_LABEL' | translate }}\uD83C\uDDEC\uD83C\uDDE7</label>\r\n      <input type=\"text\" id=\"product-desc-en\" name=\"product-desc\" [(ngModel)]=\"selectedDescriptionEn\" [placeholder]=\"'PRODUCT.DESC_PLACEHOLDER' | translate\" />\r\n      <label for=\"product-desc\">{{ 'PRODUCT.DESC_LABEL' | translate }}\uD83C\uDDEB\uD83C\uDDF7</label>\r\n      <input type=\"text\" id=\"product-desc-fr\" name=\"product-desc\" [(ngModel)]=\"selectedDescriptionFr\" [placeholder]=\"'PRODUCT.DESC_PLACEHOLDER' | translate\" />\r\n      <label for=\"product-desc\">{{ 'PRODUCT.DESC_LABEL' | translate }}\uD83C\uDDE8\uD83C\uDDF3</label>\r\n      <input type=\"text\" id=\"product-desc-zh\" name=\"product-desc\" [(ngModel)]=\"selectedDescriptionZh\" [placeholder]=\"'PRODUCT.DESC_PLACEHOLDER' | translate\" />\r\n    </div>\r\n\r\n    <hr class=\"hr-features\">\r\n\r\n    <label for=\"category-select\">{{ 'PRODUCT.CATEGORY_LABEL' | translate }}</label>\r\n    <select id=\"category-select\" name=\"category\" [(ngModel)]=\"selectedCategory\" (change)=\"onCategoryChange()\">\r\n      <option value=\"\">{{ 'PRODUCT.CATEGORY_PLACEHOLDER' | translate }}</option>\r\n      <option *ngFor=\"let cat of categories\" [value]=\"cat\">{{ cat }}</option>\r\n    </select>\r\n\r\n    <label for=\"subcategory-select\">{{ 'PRODUCT.SUBCATEGORY_LABEL' | translate }}</label>\r\n    <select id=\"subcategory-select\" name=\"subcategory\" [(ngModel)]=\"selectedSubcategory\" (change)=\"onSubcategoryChange()\">\r\n      <option value=\"\">{{ 'PRODUCT.SUBCATEGORY_PLACEHOLDER' | translate }}</option>\r\n      <option *ngFor=\"let sub of subcategories\" [value]=\"sub\">{{ sub }}</option>\r\n    </select>\r\n\r\n    <div class=\"highlighted-checkbox\">\r\n      <label for=\"highlighted\">{{ 'PRODUCT.HIGHLIGHTED_LABEL' | translate }}</label>\r\n      <input type=\"checkbox\" id=\"highlighted\" name=\"highlighted\" [(ngModel)]=\"selectedIsHighlighted\" />\r\n    </div>\r\n    <hr class=\"hr-features\" />\r\n\r\n    <div id=\"product-features\">\r\n      <label>{{ 'PRODUCT.FEATURES_LABEL' | translate }}</label>\r\n      <div *ngFor=\"let feature of features; let i = index\">\r\n        <div class=\"feature-inputs\">\r\n          <input type=\"text\" [(ngModel)]=\"feature.name\" [placeholder]=\"'PRODUCT.FEATURE_NAME_PLACEHOLDER' | translate\" />\r\n          <input type=\"text\" [(ngModel)]=\"feature.value\" [placeholder]=\"'PRODUCT.FEATURE_VALUE_PLACEHOLDER' | translate\" />\r\n        </div>\r\n        <button *ngIf=\"features.length > 1\" (click)=\"removeFeature(i)\">{{ 'PRODUCT.REMOVE_FEATURE' | translate }}</button>\r\n      </div>\r\n      <button type=\"button\" (click)=\"addFeature()\">{{ 'PRODUCT.ADD_FEATURE' | translate }}</button>\r\n    </div>\r\n\r\n    <hr class=\"hr-features\" />\r\n    <label for=\"brand-select\">{{ 'PRODUCT.BRAND_LABEL' | translate }}</label>\r\n    <select id=\"brand-select\" name=\"brand\" [(ngModel)]=\"selectedBrand\">\r\n      <option value=\"\">{{ 'PRODUCT.BRAND_PLACEHOLDER' | translate }}</option>\r\n      <option *ngFor=\"let marca of marcas\" [value]=\"marca.marca\">{{ marca.marca }}</option>\r\n    </select>\r\n\r\n    <label for=\"color-select\">{{ 'PRODUCT.COLOR_LABEL' | translate }}</label>\r\n    <select id=\"color-select\" name=\"color\" [(ngModel)]=\"selectedColor\">\r\n      <option value=\"\">{{ 'PRODUCT.COLOR_PLACEHOLDER' | translate }}</option>\r\n      <option *ngFor=\"let color of colores\" [value]=\"color.color\">{{ 'COLORS.' + color.color | translate }}</option>\r\n    </select>\r\n\r\n    <div id=\"quantity-container\">\r\n      <div class=\"quantity-selector\">\r\n        <p id=\"product-quantity\">{{ 'PRODUCT.QUANTITY_LABEL' | translate }}</p>\r\n        <p id=\"qty-value\">{{ quantity }}</p>\r\n        <button class=\"qty-button\" id=\"minus\" (click)=\"decreaseQuantity()\"><i class='bx bxs-minus-circle'></i></button>\r\n        <button class=\"qty-button\" id=\"plus\" (click)=\"increaseQuantity()\"><i class='bx bxs-plus-circle'></i></button>\r\n      </div>\r\n    </div>\r\n\r\n    <label for=\"price\">{{ 'PRODUCT.PRICE_LABEL' | translate }}</label>\r\n    <input type=\"number\" id=\"price\" name=\"price\" [(ngModel)]=\"selectedPrice\" placeholder=\"0.00\" step=\"0.01\" min=\"0\" />\r\n\r\n    <label for=\"discount\">{{ 'PRODUCT.DISCOUNT_LABEL' | translate }}</label>\r\n    <input type=\"number\" id=\"discount\" name=\"discount\" [(ngModel)]=\"selectedDiscount\" [value]=\"0\" placeholder=\"0\" step=\"1\" min=\"0\" max=\"100\" />\r\n\r\n    <label for=\"final-price\">{{ 'PRODUCT.FINAL_PRICE_LABEL' | translate }}</label>\r\n    <p id=\"final-price\">{{ getFinalPrice() }}€</p>\r\n\r\n    <hr class=\"hr-features\" />\r\n\r\n    <label for=\"imageUpload\">{{ 'PRODUCT.IMAGE_LABEL' | translate }}</label>\r\n    <input type=\"file\" id=\"imageUpload\" (change)=\"onImageSelect($event)\" accept=\"image/*\" />\r\n\r\n    <div *ngIf=\"imageUploaded\"></div>\r\n\r\n    <hr class=\"hr-features\" />\r\n\r\n    <div id=\"add-to-cart\">\r\n      <button type=\"button\" id=\"add-to-cart-button\" (click)=\"saveProduct()\">\r\n        {{ isEditing ? ('PRODUCT.SAVE_CHANGES' | translate) : ('PRODUCT.ADD_PRODUCT' | translate) }}\r\n      </button>\r\n    </div>\r\n\r\n    <div id=\"delete-product\" *ngIf=\"isEditing\">\r\n      <button type=\"button\" id=\"delete-product-button\" (click)=\"removeProduct()\">{{ 'PRODUCT.DELETE_PRODUCT' | translate }}</button>\r\n    </div>\r\n\r\n  </section>\r\n\r\n  <div id=\"product-image\">\r\n    <img id=\"image\" *ngIf=\"selectedImageUrl\" alt=\"{{ 'PRODUCT.IMAGE_ALT' | translate }}\" [src]=\"selectedImageUrl\" />\r\n    <div id=\"button-arrows\">\r\n      <button id=\"prev-image\"><i class='bx bx-chevron-left'></i></button>\r\n      <button id=\"next-image\"><i class='bx bx-chevron-right'></i></button>\r\n    </div>\r\n  </div>\r\n</article>\r\n
