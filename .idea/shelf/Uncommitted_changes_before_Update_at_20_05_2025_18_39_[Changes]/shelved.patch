<+><main>\r\n  <article id=\"product-details\">\r\n    <section id=\"product-details-info\">\r\n      <h1 id=\"product-name\">{{ getTranslatedName() }}</h1>\r\n      <p id=\"product-desc\">{{ getTranslatedDescription() }}</p>\r\n\r\n      <p id=\"features\">{{ 'PRODUCT_DETAIL.FEATURES_TITLE' | translate }}</p>\r\n      <hr class=\"hr-features\" />\r\n\r\n      <div id=\"product-features\">\r\n        <div *ngFor=\"let caracteristica of product.Caracteristicas; let i = index; trackBy: trackByIndex\">\r\n          <p>{{ caracteristica.name }}: {{ caracteristica.value }}</p>\r\n        </div>\r\n      </div>\r\n\r\n      <hr class=\"hr-features\" />\r\n\r\n      <p id=\"product-stock\" *ngIf=\"product\">\r\n        {{ 'PRODUCT_DETAIL.STOCK' | translate }}:\r\n        <span [ngClass]=\"{\r\n          'stock-green': product.Stock > 10,\r\n          'stock-orange': product.Stock > 0 && product.Stock <= 7,\r\n          'stock-red': product.Stock === 0\r\n        }\">\r\n          {{ getStockMessage() }}\r\n        </span>\r\n      </p>\r\n      <div id=\"quantity-container\">\r\n        <div class=\"quantity-selector\">\r\n          <p id=\"product-quantity\">{{ 'PRODUCT_DETAIL.QUANTITY' | translate }}: </p>\r\n          <button class=\"qty-button\" id=\"minus\" (click)=\"decrementQty()\">\r\n            <i class=\"bx bxs-minus-circle\"></i>\r\n          </button>\r\n          <p id=\"qty-value\">{{ cantidad }}</p>\r\n          <button\r\n            class=\"qty-button\"\r\n            id=\"plus\"\r\n            (click)=\"incrementQty()\"\r\n            [disabled]=\"cantidad >= product.Stock\"\r\n            [ngClass]=\"{ 'disabled-button': cantidad >= product.Stock }\">\r\n            <i class=\"bx bxs-plus-circle\"></i>\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <p id=\"final-price\" *ngIf=\"product.Descuento && product.Descuento > 0 && product.Descuento < 100\">\r\n        {{ 'PRODUCT_DETAIL.TOTAL_PRICE' | translate }}:\r\n        <span id=\"price\" style=\"text-decoration: line-through; color: #888;\">\r\n          {{ (product.Precio * cantidad).toFixed(2) }} €\r\n        </span>\r\n        <span style=\"color: red; font-weight: bold; font-size: 1.4em;\">\r\n          {{ (getPrecioConDescuento() * cantidad).toFixed(2) }} €\r\n        </span>\r\n      </p>\r\n\r\n      <p id=\"final-price\" *ngIf=\"!product.Descuento || product.Descuento === 0 || product.Descuento >= 100\">\r\n        {{ 'PRODUCT_DETAIL.TOTAL_PRICE' | translate }}:\r\n        <span id=\"price\">{{ (product.Precio * cantidad).toFixed(2) }} €</span>\r\n      </p>\r\n\r\n      <hr class=\"hr-features\" />\r\n\r\n      <div id=\"add-to-cart\">\r\n        <button type=\"button\" id=\"add-to-cart-button\" (click)=\"shoppingCartService.addToCart(product, cantidad)\">\r\n          {{ 'PRODUCT_DETAIL.ADD_TO_CART' | translate }}\r\n        </button>\r\n      </div>\r\n\r\n      <div id=\"edit-product\" *ngIf=\"isAdmin\">\r\n        <button id=\"edit-product-button\" (click)=\"editProduct()\">\r\n          {{ 'PRODUCT_DETAIL.EDIT' | translate }}\r\n        </button>\r\n      </div>\r\n\r\n      <div id=\"wish-list\" *ngIf=\"isLoggedIn\">\r\n        <button id=\"wish-list-button\" (click)=\"addToWishList()\">\r\n          <i class=\"fi fi-rr-heart\"></i> {{ 'PRODUCT_DETAIL.ADD_TO_WISHLIST' | translate }}\r\n        </button>\r\n      </div>\r\n    </section>\r\n\r\n    <div id=\"product-image\">\r\n      <img id=\"image\" alt=\"{{ 'PRODUCT_DETAIL.IMAGE_ALT' | translate }}\" [src]=\"imageUrl\" />\r\n      <div id=\"button-arrows\">\r\n        <button id=\"prev-image\"><i class=\"bx bx-chevron-left\"></i></button>\r\n        <button id=\"next-image\"><i class=\"bx bx-chevron-right\"></i></button>\r\n      </div>\r\n    </div>\r\n  </article>\r\n\r\n  <section id=\"product-reviews\">\r\n    <h2>{{ 'PRODUCT_DETAIL.REVIEWS_TITLE' | translate }}</h2>\r\n\r\n    <div class=\"reviews-container\">\r\n      <div class=\"media-box\">\r\n        <p class=\"media-label\">{{ 'PRODUCT_DETAIL.AVG_SCORE' | translate }}</p>\r\n        <div class=\"media-stars\">\r\n          <i *ngFor=\"let star of [1,2,3,4,5]\" class=\"bi bi-star-fill\" [ngClass]=\"{ 'checked': star <= puntuacionMedia }\"></i>\r\n        </div>\r\n        <p class=\"media-number\">{{ puntuacionMedia.toFixed(1) }}/5</p>\r\n        <p class=\"media-count\">\r\n          {{ 'PRODUCT_DETAIL.BASED_ON' | translate:{ count: product.Valoraciones?.length || 0 } }}\r\n        </p>\r\n        <button\r\n          *ngIf=\"isLoggedIn && !valorado\"\r\n          class=\"add-review-btn\"\r\n          (click)=\"mostrarModalValoracion()\"\r\n        >\r\n          <i class=\"bi bi-plus-lg\"></i>\r\n        </button>\r\n      </div>\r\n\r\n      <div class=\"reviews-wrapper\">\r\n        <div *ngIf=\"product && product.Valoraciones && product.Valoraciones.length > 0; else noReviews\">\r\n          <div class=\"reviews-grid\">\r\n            <div class=\"review-card\" *ngFor=\"let val of product.Valoraciones | slice:0:valoracionesMostradas\">\r\n              <div class=\"review-user\">{{ 'PRODUCT_DETAIL.FROM' | translate }} {{ val.Usuario || 'Anónimo' }}</div>\r\n              <p class=\"review-date\">{{ val.Fecha | date:'dd/MM/yyyy' }}</p>\r\n              <div class=\"review-stars\">\r\n                <i *ngFor=\"let star of [1,2,3,4,5]\" class=\"bi bi-star-fill\" [ngClass]=\"{ 'checked': star <= val.Puntuacion }\"></i>\r\n              </div>\r\n              <p class=\"review-comment\">“{{ val.Comentario || 'PRODUCT_DETAIL.NO_COMMENT' | translate }}”</p>\r\n              <div class=\"review-footer\" *ngIf=\"val.uid === obtenerUidUsuario()\">\r\n                <div class=\"review-buttons\">\r\n                  <button class=\"edit-btn\" (click)=\"editarValoracion(val)\">{{ 'PRODUCT_DETAIL.EDIT_REVIEW' | translate }}</button>\r\n                  <button class=\"delete-btn\" (click)=\"eliminarValoracion(val)\">{{ 'PRODUCT_DETAIL.DELETE_REVIEW' | translate }}</button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"ver-mas-container\" *ngIf=\"product && product.Valoraciones && product.Valoraciones.length > valoracionesMostradas\">\r\n            <button class=\"ver-mas-btn\" (click)=\"mostrarMasValoraciones()\">\r\n              {{ 'PRODUCT_DETAIL.SEE_MORE_REVIEWS' | translate }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n\r\n    <ng-template #noReviews>\r\n      <p>{{ 'PRODUCT_DETAIL.NO_REVIEWS' | translate }}</p>\r\n    </ng-template>\r\n  </section>\r\n\r\n  <div class=\"modal-overlay\" *ngIf=\"mostrarModal\">\r\n    <div class=\"modal\">\r\n      <h2>{{ 'PRODUCT_DETAIL.ADD_REVIEW_TITLE' | translate }}</h2>\r\n      <div class=\"rating\">\r\n        <i *ngFor=\"let star of [0,1,2,3,4]; let i = index\"\r\n           class=\"bi bi-star-fill star\"\r\n           [ngClass]=\"{ 'checked': i < valoracion }\"\r\n           (click)=\"seleccionarEstrella(i)\">\r\n        </i>\r\n      </div>\r\n      <textarea\r\n        [(ngModel)]=\"comentario\"\r\n        maxlength=\"200\"\r\n        rows=\"3\"\r\n        [placeholder]=\"'PRODUCT_DETAIL.COMMENT_PLACEHOLDER' | translate\"\r\n        class=\"comentario-textarea\">\r\n      </textarea>\r\n      <div class=\"char-counter\">{{ comentario.length }}/200</div>\r\n      <div id=\"buttons\">\r\n        <button id=\"send\" (click)=\"valorar()\">{{ 'PRODUCT_DETAIL.SEND' | translate }}</button>\r\n        <button id=\"close\" (click)=\"cerrarModal()\">{{ 'PRODUCT_DETAIL.CLOSE' | translate }}</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</main>\r\n
